{
  "name": "reface-id",
  "version": "1.0.0",
  "description": "3D Facial Reconstruction App for Forensic Use — powered by Blender Engine",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "start:backend": "python backend/server.py",
    "dev": "concurrently \"npm run start:backend\" \"electron .\"",
    "build": "electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "ui:vendor": "node scripts/vendor-assets.js",
    "ui:extract": "node scripts/extract-ui-manifest.js",
    "ui:build": "node scripts/build-ui.js",
    "ui:verify": "node scripts/verify-ui.js",
    "ui:smoke": "node scripts/smoke.mjs",
    "face:probe": "node scripts/face-probe.mjs",
    "face:verify": "node scripts/verify-realism.mjs",
    "test:snapshots": "node scripts/snapshot-check.mjs",
    "ui": "npm run ui:build && npm run ui:verify"
  },
  "author": "REface ID Team",
  "license": "ISC",
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "cheerio": "^1.2.0",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "lucide-static": "^1.31.0",
    "playwright-core": "^1.62.1"
  },
  "dependencies": {
    "express": "^4.18.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^13.1.0",
    "node-fetch": "^2.7.0",
    "three": "^0.160.0"
  },
  "build": {
    "appId": "com.refaceid.forensic",
    "productName": "REface ID",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  }
}
