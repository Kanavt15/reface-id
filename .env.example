# REface ID — environment configuration
#
# Copy to `.env` in the project root and fill in the key for whichever provider
# you use. The backend reads this file on startup (backend/server.py), so
# restart the backend after changing anything here.

# ─── AI providers ────────────────────────────────────────────
# Keys here are optional and exist for working on the source. The app asks for
# a key the first time an AI feature is used and stores it in the user data
# directory, which is what a packaged build relies on — an installed copy has
# no .env and no way to write one.
#
# A key entered in the app wins over the one here: the dialog is the only
# control an operator can see, so saving a key there has to take effect.
# Remove a saved key from the same dialog to fall back to these.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Which provider drives natural-language face building.
# Options: anthropic | gemini
AI_PROVIDER=anthropic

# Claude model used when a request doesn't name one. The model picker in the
# app overrides this per request; this is the fallback.
#   claude-opus-5      (default) — best structural reasoning, slowest
#   claude-sonnet-5
#   claude-opus-4-7
#   claude-sonnet-4-6
#   claude-haiku-4-5-20251001 — fastest and cheapest, but does not support the
#                               adaptive thinking the other models are sent
ANTHROPIC_MODEL=claude-opus-5

# The Gemini model is fixed at gemini-1.5-flash in backend/server.py and has no
# environment override.
